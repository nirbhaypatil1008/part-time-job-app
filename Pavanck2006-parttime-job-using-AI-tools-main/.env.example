PORT=8080
MONGO_URI=mongodb://127.0.0.1:27017/parttimejob_db?replicaSet=rs0
JWT_SECRET=replace-with-a-long-random-secret

# Email verification and password reset
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SENDER_NAME=PartTime Job

# Optional reverse geocoding API
GOOGLE_MAPS_API_KEY=

# Required only for `npm run migrate:mysql`
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=parttimejob_db
MYSQL_USER=
MYSQL_PASSWORD=

# Optional seed accounts for `npm run seed` (set each password before seeding)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_PHONE=+10000000001
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=
SEED_OWNER_PHONE=+10000000002
SEED_STUDENT_EMAIL=student@example.com
SEED_STUDENT_PASSWORD=
SEED_STUDENT_PHONE=+10000000003
